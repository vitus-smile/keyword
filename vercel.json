{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "keyword-two-phi.vercel.app"
        }
      ],
      "destination": "https://keyword.8282ok.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:page(google|naver|youtube|tiktok|threads)",
      "destination": "/p/:page.html"
    },
    {
      "source": "/instagram",
      "destination": "/"
    },
    {
      "source": "/day",
      "destination": "/day/index.html"
    },
    {
      "source": "/day/:date",
      "destination": "/day/:date.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
